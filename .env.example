# Supabase — Frankfurt region project. Local dev values come from `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix, never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode until launch). Webhook secret comes from `stripe listen` locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
